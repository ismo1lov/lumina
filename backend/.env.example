# Server
PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lumina
# DATABASE_URL=mysql://user:password@host:3306/lumina

# Auth (use long random values in production)
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_LOGIN=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_EMAIL=admin@example.com

# Public URLs
PUBLIC_APP_URL=http://localhost:8080
# Comma-separated list of allowed browser origins. Leave empty in local dev.
CORS_ORIGINS=http://localhost:8080

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Payme Business (Merchant API)
PAYME_ENABLED=false
PAYME_MERCHANT_ID=
PAYME_KEY=
# Production default; use the test checkout URL supplied by Payme for sandbox.
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# Click Business (Shop API)
CLICK_ENABLED=false
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay
