# Local development API (backend runs on port 3001)
VITE_API_URL=http://localhost:3001/api

# Production example:
# VITE_API_URL=https://your-backend.onrender.com/api

# Optional: Yandex Maps JS API key for map display.
# VITE_YANDEX_MAPS_API_KEY=

# Optional: Yandex Geocoder key for house-level reverse geocoding.
# When omitted, the app falls back to OpenStreetMap/Nominatim.
# VITE_YANDEX_GEOCODER_API_KEY=
